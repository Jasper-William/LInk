# 网站公开地址（可以公开）
NEXT_PUBLIC_SITE_URL=https://link-hr.com

# Payload CMS 必需配置（必须保密）
# 从 Vercel Marketplace 创建 Neon 数据库后自动获得
DATABASE_URL=

# 至少 32 位随机字符，用于后台登录、Cookie 和加密
PAYLOAD_SECRET=

# 从 Vercel Storage 创建 Blob Store 后自动获得
BLOB_READ_WRITE_TOKEN=

# 联系表单邮件（必须保密）
RESEND_API_KEY=

# 接收官网咨询的内部邮箱（不要写在网页代码中）
CONTACT_TO_EMAIL=

# 发件人地址。完成 Resend 域名验证后，改为例如 LINK-HR 官网 <website@link-hr.com>
CONTACT_FROM_EMAIL=LINK-HR 官网 <onboarding@resend.dev>
