# 网站公开地址（可以公开）
NEXT_PUBLIC_SITE_URL=https://link-hr.com

# Sanity 官网后台（Project ID 和 Dataset 可以公开）
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity 发布后立即刷新官网（必须保密，自行生成一串随机文字）
SANITY_REVALIDATE_SECRET=

# 联系表单邮件（必须保密）
RESEND_API_KEY=

# 接收官网咨询的内部邮箱（不要写在网页代码中）
CONTACT_TO_EMAIL=

# 发件人地址。完成 Resend 域名验证后，改为例如 LINK-HR 官网 <website@link-hr.com>
CONTACT_FROM_EMAIL=LINK-HR 官网 <onboarding@resend.dev>
